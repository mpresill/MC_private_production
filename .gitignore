# Python bytecode caches
__pycache__/
*.pyc

# CMSSW release areas (built locally via cmsrel/scram)
CMSSW_*/
CMSSW_*.tar.gz

# CRAB generation output and job working areas
OSWWemu_EWK_dim6_topU3l_*/
crab_OSWWemu_EWK_dim6_topU3l_*/
crab_utils/
crab.log

# crab preparelocal / local test output
local/
test/

# 2024_VBS (jinw's gen_VBS chain, adapted): condor job logs, stray local run output
2024_VBS/*/condor/err/*
2024_VBS/*/condor/out/*
2024_VBS/*/condor/logs/*
!2024_VBS/*/condor/*/.gitkeep
# per-retry job index lists written by submitter.sh --resubmit
2024_VBS/*/condor/resubmit_*.txt
2024_VBS/*/*.root

# inputs that are the same for all 10 samples (~80MB PreMix cfg, CMSSW tarballs) are
# tracked once in 2024_VBS/common/; old per-sample copies are ignored
2024_VBS/*/gen-sim_to_premixraw.py
!2024_VBS/common/gen-sim_to_premixraw.py
!2024_VBS/common/CMSSW_*.tar.gz
# CRAB task work areas of 2024_VBS/crab
2024_VBS/crab/tasks/
