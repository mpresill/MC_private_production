universe = vanilla
# one shared log file per cluster: CERN dropped support for per-job log files in
# January 2026 (submit requirement NoProcIdInLog) - they make the schedd unresponsive
log = condor/logs/log_$(Cluster).log
error = condor/err/err.$(procid)
output = condor/out/out.$(procid)
should_transfer_files = YES
transfer_input_files = CMSSW_14_0_21_patch4.tar.gz,CMSSW_14_0_22.tar.gz,CMSSW_15_0_17.tar.gz,lhe-gen-sim.py,gen-sim_to_premixraw.py,premixraw_to_aod.py,aod_to_miniaod.py,miniaod_to_nanoaod.py
# the NanoAOD is staged out to EOS by run.sh itself, so nothing must come back:
# without this condor would ship the whole untarred CMSSW area back to the submit dir
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
batch_name = run $(outdir)
executable = run.sh
# proxy: whatever X509_USER_PROXY points to when condor_submit runs
# (submit.sh / submitter.sh default it to $HOME/.proxy)
use_x509userproxy = true

# events per job x jobs per sample = 5,000,000 events per sample.
# keeplog=1 archives the full per-job log to <outdir>/logs/ (reference sample only);
# failing jobs archive their log regardless. Override any of these at submit time:
#   condor_submit outdir=... nevents=1000 njobs=5000 nthreads=2 keeplog=1 run.jdl
# ('if ! defined' is required: a plain assignment here would overwrite the
#  command-line value, since command-line macros are set before the file is read)
if ! defined nevents
  nevents = 1000
endif
if ! defined nthreads
  nthreads = 2
endif
if ! defined keeplog
  keeplog = 0
endif
if ! defined ncpus
  ncpus = 2
endif
# CERN wall-time limit: tomorrow = 1 day, testmatch = 3 days, nextweek = 1 week.
# Samples whose jobs run for ~a day need more than "tomorrow" or the schedd kills
# them just short of the finish line (SYSTEM_PERIODIC_REMOVE, wall time exceeded)
if ! defined flavour
  flavour = tomorrow
endif
environment = "NEVENTS=$(nevents) NTHREADS=$(nthreads) KEEPLOG=$(keeplog)"
arguments = $(outdir) $(procid)

# measured 500 ev/1 thread: 3765 MB peak RSS, 4h08m wall (29.7 s/event).
# measured 1000 ev/2 threads: 4541 MB peak RSS, 6h17m wall (22.6 s/event) - a
# 1.31x speedup, limited by the LHEGS step (66% of wall time) which barely
# threads. CERN slots carve ~3000 MB/core, so 6000 MB is already a 2-core
# slot regardless of ncpus - nthreads=2/ncpus=2 uses the core for free.
request_cpus = $(ncpus)
request_memory = 6000
request_disk = 6000000
+JobFlavour = "$(flavour)"

max_materialize = 2000

# Normal submission queues jobs 0..njobs-1. Passing a joblist instead re-runs
# exactly the job indices listed in that file, one integer per line:
#   condor_submit outdir=... joblist=condor/resubmit_<stamp>.txt run.jdl
# A retried job keeps its original index, so it reuses the same random seed and
# writes the same nanoaod_<index>.root - a retry replaces its own output and can
# never duplicate another job's events
# (one queue statement only: condor rejects a submit file with more than one, so
# the branch picks the *arguments* of the single queue below)
if defined joblist
  qspec = procid from $(joblist)
else
  # njobs only means anything here: a joblist submission would just make
  # condor_submit warn that the macro went unused
  if ! defined njobs
    njobs = 5000
  endif
  procid = $(Process)
  qspec = $(njobs)
endif
queue $(qspec)
